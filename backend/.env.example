# ------------------------------------------------------------------
# Em desenvolvimento: copie para .env
# No Railway: cadastre estas variáveis em Service → Variables
# ------------------------------------------------------------------

# Senha do painel administrativo (obrigatória, mínimo 10 caracteres)
ADMIN_PASSWORD=troque-esta-senha

# Chave que criptografa as chaves de API no banco (AES-256-GCM).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Não troque depois: as chaves salvas deixariam de ser legíveis.
ENCRYPTION_KEY=

# Origem do painel no GitHub Pages (sem caminho e sem barra no final).
# Ex.: https://delta-1.github.io
# Vazio = aceita qualquer origem (a senha + token continuam obrigatórios).
ADMIN_ORIGINS=

# IDs das extensões autorizadas a usar a API, separados por vírgula.
# Pegue o ID em chrome://extensions. Vazio = qualquer extensão (só para testes).
ALLOWED_EXTENSION_IDS=

# --- Opcionais ---------------------------------------------------------

# Porta HTTP (o Railway define PORT automaticamente)
# PORT=3000

# Caminho do SQLite. No Railway, se houver um Volume, o banco vai para ele
# automaticamente (RAILWAY_VOLUME_MOUNT_PATH/resolvy.db).
# DATABASE_PATH=./data/resolvy.db

# Confiar no proxy reverso (automático no Railway). Use 1 em outras hospedagens com HTTPS.
# TRUST_PROXY=1

# Limite de caracteres de texto aceitos por requisição
# MAX_TEXT_CHARS=15000
