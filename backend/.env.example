# Porta HTTP do servidor
PORT=3000

# Senha do painel administrativo (/admin). Use uma senha forte.
ADMIN_PASSWORD=troque-esta-senha

# Chave usada para criptografar as chaves de API no banco (AES-256-GCM).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Caminho do arquivo SQLite
DATABASE_PATH=./data/resolvy.db

# IDs das extensões autorizadas a chamar a API, separados por vírgula.
# Deixe vazio durante o desenvolvimento para aceitar qualquer chrome-extension://
ALLOWED_EXTENSION_IDS=

# Defina como 1 quando rodar atrás de um proxy reverso com HTTPS (Nginx, Railway, Render...)
TRUST_PROXY=0

# Limite de caracteres de texto aceitos por requisição
MAX_TEXT_CHARS=15000
